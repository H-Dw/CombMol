{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["decisions"],
  "properties": {"decisions": {"type": "array", "items": {
    "type": "object", "additionalProperties": false,
    "required": ["candidate_identifier", "keep", "evidence_ids", "rationale"],
    "properties": {"candidate_identifier": {"type": "string"}, "keep": {"type": "boolean"},
      "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "rationale": {"type": "string", "minLength": 1, "maxLength": 1800}}
  }}}
}
