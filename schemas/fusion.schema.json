{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["proposals", "unselected_pairs"],
  "properties": {
    "proposals": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "parent_regions", "evidence_ids", "interaction_complementarity", "chemical_integrity", "attachment_feasibility", "uncertainty"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^fusion-[0-9]{2}$"},
        "parent_regions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["parent_identifier", "region_identifiers"],
          "properties": {"parent_identifier": {"type": "string"}, "region_identifiers": {
            "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
        "evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "interaction_complementarity": {"type": "string", "minLength": 1, "maxLength": 1800},
        "chemical_integrity": {"type": "string", "minLength": 1, "maxLength": 1800},
        "attachment_feasibility": {"type": "string", "minLength": 1, "maxLength": 1800},
        "uncertainty": {"type": "string", "minLength": 1, "maxLength": 1800}
      }
    }},
    "unselected_pairs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["parents", "reason"], "properties": {
        "parents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1800}}}}
  }
}
